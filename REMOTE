local function short(v)
    if typeof(v) ~= "Instance" then return tostring(v) end
    local ok, n = pcall(function() return v:GetFullName() end)
    return ok and (n:gsub("^ReplicatedStorage%.Remotes%.", "")) or tostring(v)
end
local function ser(v, d)
    d = d or 0
    local t = typeof(v)
    if t == "string" then return string.format("%q", v)
    elseif t == "Instance" then return "<" .. v.ClassName .. "> " .. short(v)
    elseif t == "Vector3" then return string.format("Vector3.new(%.2f,%.2f,%.2f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then local p = v.Position return string.format("CFrame.new(%.2f,%.2f,%.2f)", p.X, p.Y, p.Z)
    elseif t == "function" then return "function"
    elseif t == "table" then
        if d > 3 then return "{...}" end
        local p = {}
        for k, x in pairs(v) do p[#p+1] = "[" .. ser(k, d+1) .. "]=" .. ser(x, d+1) end
        return "{" .. table.concat(p, ", ") .. "}"
    end
    return tostring(v)
end
local function argStr(t, from)
    local a = {}
    for i = from or 1, t.n do a[#a+1] = ser(t[i]) end
    return table.concat(a, ", ")
end

