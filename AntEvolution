    tostring(game.PlaceId), tostring(not CONFIG.EnableActions))
say('BOOT', 'Known paths: ClientOrbs, Ants.Critters, Game.LostEggs, Game.Gates')
say('BOOT', 'Built-in actions: Humanoid MoveTo only; no game Remotes called. Full Auto Play UNVERIFIED. F8=STOP')

-- Polling avoids a full Workspace scan of ~84,000 Instance records per tick.
task.spawn(function()
    local lastReport = 0
    while controller.Running do
        local cs = characterState()
        if cs then
            controller.Statistics.ticks += 1
            local state = {
                Position = cs.Position,
                Root = cs.Root,
                Humanoid = cs.Humanoid,
                Health = cs.Health,
                MaxHealth = cs.MaxHealth,
                Alive = cs.Alive,
                Progress = progress(),
            }
            runObservations(state)
            runActions(state)
            controller.Cache = {
                UpdatedAt = os.clock(),
                Progress = state.Progress,
                OrbCount = state.OrbCount,
                CritterCount = state.CritterCount,
                EggCount = state.EggCount,
                LowHealth = state.LowHealth,
            }
            if os.clock() - lastReport >= CONFIG.ReportSeconds then
                lastReport = os.clock()
                say('STATUS', 'Orbs=%s Critters=%s Eggs=%s | walk=%d action attempts=%d verified=%d failed=%d',
                    tostring(state.OrbCount), tostring(state.CritterCount), tostring(state.EggCount),
                    controller.Statistics.walks, controller.Statistics.actions, controller.Statistics.verified, controller.Statistics.failed)
            end
        else
            logChange('character', 'missing', 'No character/root; waiting for respawn')
        end
        task.wait(CONFIG.TickSeconds)
    end
end)

