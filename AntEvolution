local function upgradeAdvisor(state)
    local data = readAdapter('upgrade_advisor', state)
    if type(data) ~= 'table' or type(data.options) ~= 'table' then return end
    local best, score = nil, -math.huge
    for _, option in ipairs(data.options) do
        if type(option.cost) == 'number' and option.cost > 0
            and type(option.gain) == 'number' and option.affordable == true then
            local candidate = option.gain / option.cost
            if candidate > score then best, score = option, candidate end
        end
    end
    if best and best.id then
        logChange('upgrade_advisor', tostring(best.id),
            'Upgrade suggestion %s (gain / cost = %.3f; assumes comparable effect)',
            tostring(best.id), score)
    end
end

