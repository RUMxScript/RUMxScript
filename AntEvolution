-- Conditional action categories; adapter Plan validates the game-specific preconditions.
local actionOrder = {
    'orb_auto_collect',
    'lost_egg_auto_visit',
    'zone_navigation',
    'combat_auto_bite',
    'ability_scheduler',
    'daily_claim',
    'upgrade_autobuy',
    'evolve_auto',
    'pet_hatch_fuse',
    'mutation_automatic',
    'rebirth_automatic',
}

local function runObservations(state)
    -- Dependencies: moving toward an orb/egg/gate needs a fresh target snapshot.
    if featureOn('orb_tracker') or featureOn('orb_auto_collect') then
        attempt('orb_tracker', orbTracker, state)
    end
    if featureOn('lost_egg_tracker') or featureOn('lost_egg_auto_visit') then
        attempt('lost_egg_tracker', lostEggTracker, state)
    end
    if featureOn('zone_navigation') then attempt('zone_navigation_observe', zoneHint, state) end
    for name, handler in pairs(handlers) do
        if name ~= 'orb_tracker' and name ~= 'lost_egg_tracker' and name ~= 'zone_navigation'
            and featureOn(name) then
            attempt(name, handler, state)
        end
    end
    -- Safety check may not depend on whether user enabled notifications.
    if state.Health ~= nil and state.MaxHealth and state.MaxHealth > 0 then
        state.LowHealth = state.Health / state.MaxHealth <= CONFIG.LowHealthRatio
    end
end

local function runActions(state)
    if not state.Alive or state.LowHealth then return end
    for _, feature in ipairs(actionOrder) do
        local acted = false
        if feature == 'orb_auto_collect' then
            acted = attempt('orb_walk', tryApproachOrb, state) == true
        elseif feature == 'lost_egg_auto_visit' then
            acted = attempt('egg_walk', tryVisitEgg, state) == true
        elseif feature == 'zone_navigation' then
            acted = attempt('gate_walk', tryNavigateGate, state) == true
        elseif CONFIG.EnableActions and canPerform(feature) then
            acted = adapterAction(feature, state)
        end
        if acted then break end
    end
end

function controller:Stop(reason)
    if not self.Running then return end
    self.Running = false
    CONFIG.EnableMovement = false
    CONFIG.EnableActions = false
    for _, connection in ipairs(self.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    local c = characterState()
    if c and c.Humanoid then
        pcall(function() c.Humanoid:MoveTo(c.Position) end)
    end
    say('STOP', '%s | ticks=%d, attempted=%d, verified=%d, failed=%d',
        tostring(reason or 'manual stop'), self.Statistics.ticks,
        self.Statistics.actions, self.Statistics.verified, self.Statistics.failed)
end

function controller:GetFeatureSummary()
    local list = {}
    for feature, enabled in pairs(CONFIG.Features) do
        table.insert(list, {name=feature, enabled=enabled, blocked=self.Blocked[feature] == true})
    end
    table.sort(list, function(a,b) return a.name < b.name end)
    return list
end

local adapterOnly = {
    combat_auto_bite = true, ability_scheduler = true, daily_claim = true,
    upgrade_autobuy = true, evolve_auto = true, pet_hatch_fuse = true,
    mutation_automatic = true, rebirth_automatic = true,
}

function controller:SetFeature(name, enabled)
    if not self.Running then return false, 'Controller already stopped (re-run script)' end
    if CONFIG.Features[name] == nil or name == 'all_game_autoplay' then
        return false, 'Unknown/unsupported feature'
    end
    if enabled == true and adapterOnly[name] and not hasFullAdapter() then
        return false, 'Unverified game adapter. Feature not runnable yet.'
    end
    CONFIG.Features[name] = (enabled == true)
    if not enabled and self.WalkTarget and (name == 'orb_auto_collect' or
        name == 'lost_egg_auto_visit' or name == 'zone_navigation') then
        local cs = characterState()
        if cs and cs.Humanoid then cs.Humanoid:MoveTo(cs.Position) end
    end
    return true
end

function controller:SetMovementEnabled(enabled)
    if not self.Running then return false, 'Controller already stopped (re-run script)' end
    CONFIG.EnableMovement = (enabled == true)
    if not CONFIG.EnableMovement then
        local cs = characterState()
        if cs and cs.Humanoid then cs.Humanoid:MoveTo(cs.Position) end
    end
    say('INFO', 'Humanoid movement assistant=%s', tostring(CONFIG.EnableMovement))
    return true
end

function controller:SetGateTarget(target)
    local valid = {Garden='Gate_Garden', Hollow='Gate_Hollow', Picnic='Gate_Picnic'}
    if not valid[target] then return false, 'Unknown destination' end
    CONFIG.TargetZoneGate = valid[target]
    say('INFO', 'Gate target=%s', CONFIG.TargetZoneGate)
    return true
end

function controller:SetActionsEnabled(enabled)
    if enabled and not hasFullAdapter() then
        return false, 'No complete verified game adapter'
    end
    CONFIG.EnableActions = enabled == true
    return true
end

-- F8 stops without creating any UI.
table.insert(controller.Connections, UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == CONFIG.EmergencyStopKey then
        controller:Stop('F8 emergency stop')
    end
end))

