local function readAdapter(name, state)
    if type(Adapter.Read) ~= 'function' then return nil end
    return attempt('Adapter.Read.' .. name, function() return Adapter:Read(name, state) end)
end

local function isSpending(feature)
    return feature == 'upgrade_autobuy' or feature == 'pet_hatch_fuse'
        or feature == 'mutation_automatic' or feature == 'rebirth_automatic'
end

local function canPerform(feature)
    if not featureOn(feature) or not CONFIG.EnableActions then return false end
    if controller.Statistics.actions >= CONFIG.MaxActionsPerSession then return false end
    if isSpending(feature) then
        if not CONFIG.AllowResourceSpending then return false end
        if controller.Statistics.spendActions >= CONFIG.MaxSpendActionsPerSession then return false end
    end
    if feature == 'rebirth_automatic' and not CONFIG.AllowRebirth then return false end
    if os.clock() - (controller.LastActionAt[feature] or -1e9) < CONFIG.ActionCooldown then
        return false
    end
    return true
end

local function hasFullAdapter()
    for _, name in ipairs({'Read','Plan','Snapshot','Execute','Verify'}) do
        if type(Adapter[name]) ~= 'function' then return false end
    end
    return true
end

-- Executable gameplay actions require a complete, authorized, verified adapter.
-- If Snapshot/Verify cannot prove the result, feature is NOT counted as success.
local function adapterAction(feature, state)
    if not canPerform(feature) or not hasFullAdapter() then return false end
    local payload = attempt('Adapter.Plan.' .. feature,
        function() return Adapter:Plan(feature, state, controller) end)
    if payload == nil or payload == false then return false end
    local before = attempt('Adapter.Snapshot.' .. feature,
        function() return Adapter:Snapshot(feature, payload, controller) end)
    if before == nil then return false end
    controller.LastActionAt[feature] = os.clock()
    controller.Statistics.actions += 1
    if isSpending(feature) then controller.Statistics.spendActions += 1 end
    local executed, message = attempt('Adapter.Execute.' .. feature,
        function() return Adapter:Execute(feature, payload, controller) end)
    if not controller.Running then return false end
    if executed ~= true then
        controller.Statistics.failed += 1
        say('WARN', '%s not executed: %s', feature, tostring(message or 'unknown'))
        return true -- an action WAS attempted; do not run another one in the same tick
    end
    task.wait(0.3)
    local after = attempt('Adapter.Snapshot.' .. feature,
        function() return Adapter:Snapshot(feature, payload, controller) end)
    if after == nil then
        controller.Statistics.failed += 1
        say('WARN', '%s: no post-action snapshot', feature)
        return true -- attempted, unverified
    end
    local verified, note = attempt('Adapter.Verify.' .. feature,
        function() return Adapter:Verify(feature, payload, before, after, controller) end)
    if verified == true then
        controller.Statistics.verified += 1
        say('OK', '%s confirmed: %s', feature, tostring(note or 'state change validated'))
        return true
    end
    controller.Statistics.failed += 1
    say('WARN', '%s UNVERIFIED: %s', feature, tostring(note or 'unknown'))
    return true -- attempted, unverified
end

-- Movement (walk only). Never teleports, never changes CFrame or bypasses game gates.
local function walkTo(targetPosition, feature)
    local char = characterState()
    if not char or not char.Alive or not char.Humanoid then return false, 'No controllable humanoid' end
    if typeof(targetPosition) ~= 'Vector3' then return false, 'Invalid target position' end
    if (targetPosition - char.Position).Magnitude > CONFIG.MaxTravelDistance then
        return false, 'Target farther than MaxTravelDistance'
    end

    local waypoints = {targetPosition}
    if CONFIG.UseBasicPathfinding then
        local path = PathfindingService:CreatePath({AgentCanJump = true})
        local ok = pcall(function() path:ComputeAsync(char.Position, targetPosition) end)
        if ok and path.Status == Enum.PathStatus.Success then
            waypoints = {}
            for _, waypoint in ipairs(path:GetWaypoints()) do
                table.insert(waypoints, waypoint)
            end
        end
    end

    local deadline = os.clock() + CONFIG.MaxMoveSeconds
    for _, waypoint in ipairs(waypoints) do
        if not controller.Running or not CONFIG.EnableMovement or not featureOn(feature) then return false, 'Stopped/toggled off' end
        local point = typeof(waypoint) == 'Vector3' and waypoint or waypoint.Position
        if typeof(waypoint) ~= 'Vector3' and waypoint.Action == Enum.PathWaypointAction.Jump then
            char.Humanoid.Jump = true
        end
        char.Humanoid:MoveTo(point)
        local reached = false
        repeat
            task.wait(0.12)
            if not controller.Running or not CONFIG.EnableMovement or not featureOn(feature) then return false, 'Stopped/toggled off' end
            local current = characterState()
            if not current or not current.Alive then return false, 'Character lost' end
            reached = (current.Position - point).Magnitude <= 4.5
        until reached or os.clock() >= deadline
        if not reached then return false, 'Move timeout' end
    end
    return true
end

-- Movement is a real, local Roblox Humanoid action. It is NOT proof of pickup.
local function canWalk(feature)
    if not controller.Running or not CONFIG.EnableMovement or not featureOn(feature) then return false end
    if controller.Statistics.actions >= CONFIG.MaxActionsPerSession then return false end
    if os.clock() - (controller.LastActionAt[feature] or -1e9) < CONFIG.ActionCooldown then return false end
    return true
end

local function walkCandidate(feature, target, label)
    if not canWalk(feature) or not target or not target:IsDescendantOf(Workspace) then return false end
    local targetPosition = positionOf(target)
    local cs = characterState()
    if not cs or not cs.Alive or not targetPosition then return false end
    local distance = (targetPosition - cs.Position).Magnitude
    if distance <= 5 then return false end
    if distance > CONFIG.MaxTravelDistance then
        logChange('far:' .. feature, uniqueId(target), '%s too far (%.1f studs); max walk distance %d',
            label, distance, CONFIG.MaxTravelDistance)
        return false
    end
    controller.LastActionAt[feature] = os.clock()
    controller.Statistics.actions += 1
    controller.WalkTarget = target
    say('INFO', '%s: walking to %s, %.1f studs', feature, label, distance)
    local ok, note = walkTo(targetPosition, feature)
    controller.WalkTarget = nil
    if ok then
        controller.Statistics.walks += 1
        say('OK', '%s reached %s. Interaction/reward remains UNVERIFIED.', feature, label)
    else
        controller.Statistics.failed += 1
        say('WARN', '%s movement failed: %s', feature, tostring(note))
    end
    return true -- a movement attempt was made
end

local function progressionWatch(state)
    local p = state.Progress
    local serial = tostring(p.Stage) .. '|' .. tostring(p.Kills) .. '|' .. tostring(p.Rebirths)
    logChange('progress', serial, 'Progress Stage=%s Kills=%s Rebirths=%s',
        tostring(p.Stage), tostring(p.Kills), tostring(p.Rebirths))
end

local function orbTracker(state)
    local orb, dist, count = scanNearest(orbFolder(), state.Position, CONFIG.MaxOrbDistance,
        function(inst) return inst.Name == 'Orb' and inst:IsA('BasePart') end)
    state.Orb, state.OrbDistance, state.OrbCount = orb, dist, count
    if orb then uniqueId(orb) end
    logChange('orbs', count, 'Visible Orb parts=%d | nearest=%s', count,
        orb and string.format('%.1f studs', dist) or 'none within search radius')
end

local function critterTargetHint(state)
    local enemy, dist, count = scanNearest(critterFolder(), state.Position, CONFIG.MaxCritterDistance,
        function(inst) return inst:IsA('Model') end)
    state.Critter, state.CritterDistance, state.CritterCount = enemy, dist, count
    if enemy then uniqueId(enemy) end
    logChange('critters', (enemy and uniqueId(enemy) or 'none'),
        'Nearby critter candidate: %s | dist=%s | listed models=%d (hostility/HP NOT verified)',
        enemy and enemy.Name or 'none', enemy and string.format('%.1f', dist) or '-', count)
end

local function lowHealthAdvisor(state)
    if state.Health == nil or not state.MaxHealth or state.MaxHealth <= 0 then return end
    local low = state.Health / state.MaxHealth <= CONFIG.LowHealthRatio
    logChange('health_warning', low, 'HP %.0f/%.0f -> %s',
        state.Health, state.MaxHealth, low and 'LOW: manual retreat recommended' or 'normal')
    state.LowHealth = low
end

local function lostEggTracker(state)
    local egg, distance, count = scanNearest(eggFolder(), state.Position, CONFIG.MaxEggDistance,
        function(inst) return inst.Name:match('^Egg_%d+$') and inst:IsA('BasePart') end)
    state.Egg, state.EggDistance, state.EggCount = egg, distance, count
    local label = egg and (egg.Name .. ':' .. string.format('%.1f', distance)) or 'none'
    logChange('egg_candidate', label, 'LostEggs visible=%d | nearest=%s (claimed status NOT verified)',
        count, label)
end

local function zoneHint(state)
    local nearest, dist, count = scanNearest(gateFolder(), state.Position, CONFIG.MaxTravelDistance,
        function(inst) return inst:IsA('Model') or inst:IsA('BasePart') end)
    state.NearestGate, state.NearestGateDistance, state.Gates = nearest, dist, count
    if nearest then
        logChange('gate', uniqueId(nearest), 'Nearest gate candidate=%s (%.1f studs); gate access unverified',
            nearest.Name, dist)
    end
end

-- Deterministic, conditional advisers: NEVER invent missing pricing/quest/rebirth state.
local function questHelper(state)
    local q = readAdapter('quest_helper', state)
