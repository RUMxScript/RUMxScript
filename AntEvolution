-- Local movement-only candidate assistants; no guessed Remote calls or fake pickup.
local function tryApproachOrb(state)
    if not canWalk('orb_auto_collect') then return false end
    local target = scanNearest(orbFolder(), state.Position, CONFIG.MaxOrbDistance,
        function(inst)
            return inst.Name == 'Orb' and inst:IsA('BasePart')
                and controller.SeenOrbs[inst] ~= true
        end)
    if not target then return false end
    local point = positionOf(target)
    if point and (point - state.Position).Magnitude <= 5 then
        controller.SeenOrbs[target] = true
        return false -- already nearby, select another Orb next tick
    end
    local attempted = walkCandidate('orb_auto_collect', target, 'Orb '..uniqueId(target))
    if attempted then
        local cs = characterState()
        local pos = positionOf(target)
        if cs and pos and (cs.Position - pos).Magnitude <= 5 then
            controller.SeenOrbs[target] = true
            say('INFO', 'Visited Orb %s. No confirmed pickup or server reward.', uniqueId(target))
        end
    end
    return attempted
end

local function tryVisitEgg(state)
    if not canWalk('lost_egg_auto_visit') then return false end
    local folder = eggFolder()
    if not folder then return false end
    local nearest = scanNearest(folder, state.Position, CONFIG.MaxEggDistance,
        function(inst)
            return inst:IsA('BasePart') and inst.Name:match('^Egg_%d+$')
                and controller.SeenEggs[inst.Name] ~= true
        end)
    if not nearest then return false end
    local attempted = walkCandidate('lost_egg_auto_visit', nearest, nearest.Name)
    -- "Seen" means physically visited, never "collected" or "claimed".
    if attempted then
        local cs = characterState()
        local point = positionOf(nearest)
        if cs and point and (cs.Position - point).Magnitude <= 5 then
            controller.SeenEggs[nearest.Name] = true
            say('INFO', 'Visited %s; egg reward/claim not verified', nearest.Name)
        end
    end
    return attempted
end

local function tryNavigateGate(state)
    if not canWalk('zone_navigation') then return false end
    local folder = gateFolder()
    if not folder then return false end
    local gate = folder:FindFirstChild(CONFIG.TargetZoneGate)
    if not gate then
        logChange('missing_gate', CONFIG.TargetZoneGate, 'Gate missing: %s', CONFIG.TargetZoneGate)
        return false
    end
    return walkCandidate('zone_navigation', gate, CONFIG.TargetZoneGate)
end

