local function say(level, fmt, ...)
    local msg = ('[RUM][%s] ' .. fmt):format(level, ...)
    if level == 'ERROR' then warn(msg) else print(msg) end
end

local function logChange(key, value, fmt, ...)
    if controller.Last[key] == value then return end
    controller.Last[key] = value
    say('INFO', fmt, ...)
end

local function featureOn(name)
    return controller.Running and CONFIG.Features[name] == true and not controller.Blocked[name]
end

local function attempt(label, fn, ...)
    local ok, a, b, c = pcall(fn, ...)
    if not ok then
        controller.Errors[label] = (controller.Errors[label] or 0) + 1
        if controller.Errors[label] <= CONFIG.MaxErrorCount then
            say('ERROR', '%s: %s', label, tostring(a))
        end
        if controller.Errors[label] >= CONFIG.MaxErrorCount then
            controller.Blocked[label] = true
            say('WARN', '%s disabled after repeated errors', label)
        end
        return nil
    end
    return a, b, c
end

local function find(root, path)
    local current = root
    for segment in string.gmatch(path, '[^%.]+') do
        if not current then return nil end
        current = current:FindFirstChild(segment)
    end
    return current
end

local function positionOf(object)
    if not object or typeof(object) ~= 'Instance' then return nil end
    if object:IsA('BasePart') then return object.Position end
    if object:IsA('Model') then
        local base = object.PrimaryPart or object:FindFirstChild('HumanoidRootPart')
        if base and base:IsA('BasePart') then return base.Position end
        local ok, cf = pcall(function() return object:GetPivot() end)
        if ok then return cf.Position end
    end
    return nil
end

local function characterState()
    local character = player.Character
    if not character then return nil end
    local root = character:FindFirstChild('HumanoidRootPart') or character.PrimaryPart
    local humanoid = character:FindFirstChildOfClass('Humanoid')
    if not root or not root:IsA('BasePart') then return nil end
    local hp, maxHp = nil, nil
    if humanoid then hp, maxHp = humanoid.Health, humanoid.MaxHealth end
    return {
        Character = character, Root = root, Humanoid = humanoid,
        Position = root.Position, Health = hp, MaxHealth = maxHp,
        Alive = hp == nil or hp > 0,
    }
end

local function progress()
    local stats = player:FindFirstChild('leaderstats')
    local result = {}
    if not stats then return result end
    for _, name in ipairs({'Stage', 'Kills', 'Rebirths'}) do
        local value = stats:FindFirstChild(name)
        if value and value:IsA('ValueBase') then result[name] = value.Value end
    end
    return result
end

local nextInstanceId = 0
local instanceIds = setmetatable({}, {__mode = 'k'})
local function uniqueId(inst)
    if not instanceIds[inst] then
        nextInstanceId += 1
        instanceIds[inst] = ('s%s:%s'):format(tostring(nextInstanceId), inst.Name)
    end
    return instanceIds[inst]
end

local function scanNearest(folder, origin, maximum, predicate)
    if not folder or not origin then return nil, math.huge, 0 end
    local closest, distance, count = nil, math.huge, 0
    for _, child in ipairs(folder:GetChildren()) do
        if not predicate or predicate(child) then
            local pos = positionOf(child)
            if pos then
                count += 1
                local d = (pos - origin).Magnitude
                if d < distance and d <= maximum then
                    distance, closest = d, child
                end
            end
        end
    end
    return closest, distance, count
end

